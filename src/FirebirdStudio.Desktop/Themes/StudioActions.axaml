<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Styles.Resources>
    <ResourceDictionary>
      <StreamGeometry x:Key="ActionAddIcon">M7 2H9V7H14V9H9V14H7V9H2V7H7Z</StreamGeometry>
      <StreamGeometry x:Key="ActionRefreshIcon">M13 3V6H10L11.1 4.9A4.4 4.4 0 1 0 12.3 9H13.9A6 6 0 1 1 12.2 3.8L13 3Z</StreamGeometry>
      <StreamGeometry x:Key="ActionExecuteIcon">M4 2L13 8L4 14Z</StreamGeometry>
      <StreamGeometry x:Key="ActionStopIcon">M4 4H12V12H4Z</StreamGeometry>
      <StreamGeometry x:Key="ActionFormatIcon">M2 3H14V4.5H2Z M5 7.25H13V8.75H5Z M2 11.5H14V13H2Z</StreamGeometry>
      <StreamGeometry x:Key="ActionClearIcon">F0 M2 4H5V2H11V4H14V5.5H2Z M6.5 3.25V4H9.5V3.25Z M3.5 7H12.5L11.8 14H4.2Z M5.3 8.3L5.7 12.7H10.3L10.7 8.3Z</StreamGeometry>
      <StreamGeometry x:Key="ActionConfirmIcon">M6.3 10.7L3.1 7.5L2 8.6L6.3 13L14 5.3L12.9 4.2Z</StreamGeometry>
      <StreamGeometry x:Key="ActionConnectIcon">M5 2H6.5V5H9.5V2H11V5H12.5V6.5H11.5V8A3.5 3.5 0 0 1 8.75 11.4V14H7.25V11.4A3.5 3.5 0 0 1 4.5 8V6.5H3.5V5H5Z</StreamGeometry>
      <StreamGeometry x:Key="ActionCollapseRightIcon">M5 3L10 8L5 13L4 12L8 8L4 4Z M12 2H13.5V14H12Z</StreamGeometry>
      <StreamGeometry x:Key="ActionExpandLeftIcon">M9 3L4 8L9 13L10 12L6 8L10 4Z M12 2H13.5V14H12Z</StreamGeometry>
      <StreamGeometry x:Key="ActionRestoreIcon">M6 2L1 7L6 12L7.1 10.9L4 7.8H10A3 3 0 0 1 10 13.8H8V15.3H10A4.5 4.5 0 0 0 10 6.3H4L7.1 3.1Z</StreamGeometry>
      <StreamGeometry x:Key="ActionSettingsIcon">F0 M6.5 1H9.5L10 3.2L11.4 3.8L13.4 2.7L15 5.3L13.4 6.8V9.2L15 10.7L13.4 13.3L11.4 12.2L10 12.8L9.5 15H6.5L6 12.8L4.6 12.2L2.6 13.3L1 10.7L2.6 9.2V6.8L1 5.3L2.6 2.7L4.6 3.8L6 3.2Z M5.5 8A2.5 2.5 0 1 0 10.5 8A2.5 2.5 0 1 0 5.5 8Z</StreamGeometry>
      <StreamGeometry x:Key="ActionCopyIcon">F0 M5 5H14V15H5Z M6.5 6.5V13.5H12.5V6.5Z M2 1H11V3.5H9.5V2.5H3.5V10.5H4V12H2Z</StreamGeometry>
      <StreamGeometry x:Key="ActionFirstRowIcon">M2 2H14V3.5H2Z M3 10L8 5L13 10L11.9 11.1L8.75 7.95V14H7.25V7.95L4.1 11.1Z</StreamGeometry>
      <StreamGeometry x:Key="ActionLastRowIcon">M2 12.5H14V14H2Z M3 6L8 11L13 6L11.9 4.9L8.75 8.05V2H7.25V8.05L4.1 4.9Z</StreamGeometry>
    </ResourceDictionary>
  </Styles.Resources>

  <Style Selector="Button.action">
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="Padding" Value="10,4" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.action.compact">
    <Setter Property="MinHeight" Value="24" />
    <Setter Property="Padding" Value="6,2" />
  </Style>
  <Style Selector="Button.action.icon-only">
    <Setter Property="MinWidth" Value="26" />
    <Setter Property="MinHeight" Value="26" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="StackPanel.action-label">
    <Setter Property="Orientation" Value="Horizontal" />
    <Setter Property="Spacing" Value="5" />
  </Style>
  <Style Selector="StackPanel.action-label > TextBlock">
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="PathIcon.action-icon">
    <Setter Property="Width" Value="14" />
    <Setter Property="Height" Value="14" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
</Styles>
