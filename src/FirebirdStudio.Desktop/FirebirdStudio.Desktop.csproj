<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="Avalonia.AvaloniaEdit" />
  </ItemGroup>
  <Target Name="PublishExternalUpdater" AfterTargets="Publish" Condition="'$(RuntimeIdentifier)' != ''">
    <Exec Command="dotnet publish &quot;$(MSBuildThisFileDirectory)../FirebirdStudio.Updater/FirebirdStudio.Updater.csproj&quot; -c $(Configuration) -f net10.0 -r $(RuntimeIdentifier) --self-contained $(SelfContained) -p:Version=$(Version) -o &quot;$(PublishDir)Updater&quot;" />
  </Target>
  <ItemGroup>
    <ProjectReference Include="..\FirebirdStudio.Core\FirebirdStudio.Core.csproj" />
    <ProjectReference Include="..\FirebirdStudio.Application\FirebirdStudio.Application.csproj" />
    <ProjectReference Include="..\FirebirdStudio.Infrastructure\FirebirdStudio.Infrastructure.csproj" />
  </ItemGroup>
</Project>
