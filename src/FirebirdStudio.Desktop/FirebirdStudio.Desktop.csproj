<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="Avalonia.AvaloniaEdit" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\..\scripts\updater\Apply-Update.ps1"
             Link="Updater\Apply-Update.ps1"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\FirebirdStudio.Core\FirebirdStudio.Core.csproj" />
    <ProjectReference Include="..\FirebirdStudio.Application\FirebirdStudio.Application.csproj" />
    <ProjectReference Include="..\FirebirdStudio.Infrastructure\FirebirdStudio.Infrastructure.csproj" />
  </ItemGroup>
</Project>
