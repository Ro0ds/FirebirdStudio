<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:FirebirdStudio.Desktop.Services"
        x:Class="FirebirdStudio.Desktop.Views.AboutWindow"
        Width="380"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Title="{loc:StudioText AboutWindow}">
  <StackPanel Margin="18" Spacing="14">
    <TextBlock x:Name="ApplicationVersionText" Classes="section-title" />
    <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="8" ColumnSpacing="16">
      <TextBlock Text="{loc:StudioText FirebirdProvider}" />
      <TextBlock Grid.Column="1" x:Name="ProviderVersionText" Classes="secondary" />
      <TextBlock Grid.Row="1" Text="Avalonia" />
      <TextBlock Grid.Row="1" Grid.Column="1" x:Name="AvaloniaVersionText" Classes="secondary" />
      <TextBlock Grid.Row="2" Text="{loc:StudioText DotNetRuntime}" />
      <TextBlock Grid.Row="2" Grid.Column="1" x:Name="RuntimeVersionText" Classes="secondary" />
    </Grid>
    <Button x:Name="CloseAboutButton" Classes="action" Content="{loc:StudioText Close}" IsCancel="True" IsDefault="True"
            HorizontalAlignment="Right" />
  </StackPanel>
</Window>
