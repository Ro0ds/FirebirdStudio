<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="FirebirdStudio.Desktop.Views.QueryResultsView">
  <Grid RowDefinitions="Auto,*" MinHeight="0">
    <Border Padding="8,3" BorderBrush="{DynamicResource StudioDividerBrush}" BorderThickness="0,0,0,1"
            Background="{DynamicResource StudioSurfaceBrush}">
      <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="6">
        <TextBlock x:Name="ResultsSummary" Classes="panel-title" VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding $self.Text}" />
        <TextBlock Grid.Column="1" x:Name="ResultsElapsed" Classes="secondary" IsVisible="False"
                   VerticalAlignment="Center" />
        <TextBlock Grid.Column="2" x:Name="PartialResults" Text="Partial preview" Classes="secondary information"
                   IsVisible="False" VerticalAlignment="Center"
                   ToolTip.Tip="The query exceeded the row or data limits for this preview." />
        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="3">
          <Button x:Name="FirstResultRowButton" Classes="action icon-only" IsEnabled="False"
                  AutomationProperties.Name="Go to first result row" ToolTip.Tip="First row">
            <PathIcon Classes="action-icon" Data="{StaticResource ActionFirstRowIcon}" />
          </Button>
          <Button x:Name="LastResultRowButton" Classes="action icon-only" IsEnabled="False"
                  AutomationProperties.Name="Go to last result row" ToolTip.Tip="Last row">
            <PathIcon Classes="action-icon" Data="{StaticResource ActionLastRowIcon}" />
          </Button>
        </StackPanel>
        <Button Grid.Column="4" x:Name="CopyResultRowButton" Classes="action compact" IsEnabled="False"
                AutomationProperties.Name="Copy selected row" ToolTip.Tip="Copy the selected row">
          <StackPanel Classes="action-label">
            <PathIcon Classes="action-icon" Data="{StaticResource ActionCopyIcon}" />
            <TextBlock Text="Copy row" />
          </StackPanel>
        </Button>
        <Button Grid.Column="5" x:Name="ClearResultsButton" Classes="action icon-only" IsEnabled="False"
                AutomationProperties.Name="Clear query results" ToolTip.Tip="Clear query results">
          <PathIcon Classes="action-icon" Data="{StaticResource ActionClearIcon}" />
        </Button>
      </Grid>
    </Border>
    <Grid Grid.Row="1" Background="{DynamicResource StudioSurfaceBrush}">
      <TableView x:Name="QueryResultsGrid" x:CompileBindings="False" SelectionMode="Single" CanUserResizeColumns="True"
                 AutomationProperties.Name="Query results" IsVisible="False">
        <TableView.Styles>
          <Style Selector="Button.result-column-sort">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="Padding" Value="0,1" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
          </Style>
          <Style Selector="TableViewRow">
            <Setter Property="Padding" Value="0,3" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="BorderBrush" Value="{DynamicResource StudioDividerBrush}" />
          </Style>
          <Style Selector="TableViewRow:selected /template/ Border#Border">
            <Setter Property="Background" Value="{DynamicResource StudioListSelectionBrush}" />
          </Style>
          <Style Selector="TableViewCell">
            <Setter Property="ToolTip.Tip" Value="{ReflectionBinding $self.Content}" />
          </Style>
          <Style Selector="TableViewCell TextBlock">
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
          </Style>
        </TableView.Styles>
      </TableView>
      <TextBlock x:Name="ResultsHint" Classes="secondary" Text="Execute SQL to see results here."
                 HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                 TextWrapping="Wrap" Margin="10" />
      <ProgressBar x:Name="ResultsProgress" Width="100" Height="4" IsIndeterminate="True" IsVisible="False"
                   HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Grid>
  </Grid>
</UserControl>
