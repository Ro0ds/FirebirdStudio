<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:edit="using:AvaloniaEdit"
    xmlns:connections="using:FirebirdStudio.Core.Connections"
    xmlns:database="using:FirebirdStudio.Core.Database"
    xmlns:services="using:FirebirdStudio.Desktop.Services"
    x:Class="FirebirdStudio.Desktop.Views.MainWindow"
    Width="1500"
    Height="940"
    WindowState="Maximized"
    MinWidth="1100"
    MinHeight="700"
    Title="Firebird Studio">
  <Window.Styles>
    <Style Selector="Button">
      <Setter Property="Padding" Value="9,5" />
    </Style>
    <!-- TreeViewItem uses a StackPanel by default. Virtualize each expanded
         category so thousands of metadata rows do not create thousands of controls. -->
    <Style Selector="TreeViewItem">
      <!-- Virtualized containers are recycled; persist expansion on the data item. -->
      <Setter Property="IsExpanded" Value="{ReflectionBinding IsExpanded, Mode=TwoWay}" />
      <Setter Property="ItemsPanel">
        <ItemsPanelTemplate>
          <VirtualizingStackPanel />
        </ItemsPanelTemplate>
      </Setter>
    </Style>
  </Window.Styles>
  <Grid RowDefinitions="Auto,*,Auto">
    <Border Grid.Row="0" Padding="10,2" Background="{DynamicResource StudioSurfaceBrush}" BorderThickness="0,0,0,1"
            BorderBrush="{DynamicResource StudioDividerBrush}">
      <DockPanel LastChildFill="False">
        <Menu DockPanel.Dock="Left" Background="Transparent">
          <MenuItem Header="_File">
            <MenuItem Header="New connection…" x:Name="AddConnectionMenuItem" />
            <Separator />
            <MenuItem Header="Exit" x:Name="ExitMenuItem" />
          </MenuItem>
          <MenuItem Header="_Connection">
            <MenuItem Header="Edit connection…" x:Name="EditConnectionMenuItem" IsEnabled="False" />
            <MenuItem Header="Remove connection" x:Name="RemoveConnectionMenuItem" IsEnabled="False" />
            <Separator />
            <MenuItem Header="Connect" x:Name="ConnectMenuItem" IsEnabled="False" />
            <MenuItem Header="Disconnect" x:Name="DisconnectMenuItem" IsEnabled="False" />
            <MenuItem Header="Refresh database objects" x:Name="RefreshMetadataMenuItem" IsEnabled="False" />
          </MenuItem>
          <MenuItem Header="_Query">
            <MenuItem Header="Execute (F5)" x:Name="ExecuteMenuItem" IsEnabled="False" InputGesture="F5" />
            <MenuItem Header="SQL autocomplete (Ctrl+Space)" x:Name="SqlAutocompleteMenuItem" IsEnabled="False" />
            <MenuItem Header="Format SQL" x:Name="FormatSqlMenuItem" InputGesture="Ctrl+Shift+F" />
            <MenuItem Header="Cancel execution" x:Name="CancelQueryMenuItem" IsEnabled="False" />
          </MenuItem>
          <MenuItem Header="_View">
            <MenuItem Header="Query history">
              <MenuItem Header="Dock on right" x:Name="HistoryDockRightMenuItem" IsChecked="True" ToggleType="Radio" GroupName="HistoryDock" />
              <MenuItem Header="Tab beside SQL Editor" x:Name="HistoryDockTabMenuItem" ToggleType="Radio" GroupName="HistoryDock" />
            </MenuItem>
            <MenuItem Header="Database connections">
              <MenuItem Header="Detailed (name, host, path)" x:Name="ConnectionDisplayDetailedMenuItem" IsChecked="True" ToggleType="Radio" GroupName="ConnectionDisplay" />
              <MenuItem Header="Minimal (name only)" x:Name="ConnectionDisplayMinimalMenuItem" ToggleType="Radio" GroupName="ConnectionDisplay" />
            </MenuItem>
          </MenuItem>
          <MenuItem Header="_Help">
            <MenuItem Header="Check for updates…" x:Name="CheckForUpdatesMenuItem" />
          </MenuItem>
        </Menu>
        <TextBlock DockPanel.Dock="Right" Text="FIREBIRD STUDIO  ·  DATABASE WORKSPACE"
                   Classes="secondary brand" VerticalAlignment="Center" Margin="12,0" />
        <Menu DockPanel.Dock="Right" Background="Transparent">
          <MenuItem Header="Toggle theme" x:Name="ToggleThemeMenuItem" />
        </Menu>
      </DockPanel>
    </Border>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="290" MinWidth="270" />
        <ColumnDefinition Width="3" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Grid Grid.Column="0" RowDefinitions="Auto,*,5,*" MinHeight="0" Margin="10">
        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,10">
          <TextBlock Grid.Column="0" Text="Database connections" Classes="panel-title"
                     VerticalAlignment="Center" />
          <Button Grid.Column="1" x:Name="ToggleConnectionDisplayButton" Content="Minimal"
                  Padding="6,3" ToolTip.Tip="Switch connection list display mode" />
        </Grid>
        <ListBox Grid.Row="1" x:Name="ConnectionsList" SelectionMode="Single">

        </ListBox>
        <GridSplitter Grid.Row="2" Height="5" HorizontalAlignment="Stretch" ResizeDirection="Rows" />
        <Grid Grid.Row="3" RowDefinitions="Auto,Auto,*" MinHeight="0">
          <Grid Grid.Row="0" Margin="0,10,0,7" ColumnDefinitions="*,Auto,Auto">
            <TextBlock Grid.Column="0" Text="Database objects" Classes="panel-title"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <Menu Grid.Column="1" VerticalAlignment="Center" Margin="3,0">
              <MenuItem Header="Organize">
                <MenuItem Header="Move selected category up" x:Name="MoveCategoryUpMenuItem" IsEnabled="False" />
                <MenuItem Header="Move selected category down" x:Name="MoveCategoryDownMenuItem" IsEnabled="False" />
              </MenuItem>
            </Menu>
            <Button Grid.Column="2" Content="Refresh" x:Name="RefreshMetadataButton" IsEnabled="False" />
          </Grid>
          <Grid Grid.Row="1" ColumnDefinitions="*,150" ColumnSpacing="6" Margin="0,0,0,6">
            <TextBox Grid.Column="0" x:Name="MetadataSearchBox" PlaceholderText="Search database objects…" />
            <ComboBox Grid.Column="1" x:Name="MetadataSearchKindFilter" SelectedIndex="0">
              <ComboBoxItem Content="All object types" />
              <ComboBoxItem Content="Tables" />
              <ComboBoxItem Content="Views" />
              <ComboBoxItem Content="Columns" />
              <ComboBoxItem Content="Procedures" />
              <ComboBoxItem Content="Triggers" />
              <ComboBoxItem Content="Indexes" />
              <ComboBoxItem Content="Domains" />
            </ComboBox>
          </Grid>
          <TreeView Grid.Row="2" x:Name="MetadataTree" SelectionMode="Single" MinHeight="0">
            <TreeView.ItemsPanel>
              <ItemsPanelTemplate>
                <VirtualizingStackPanel />
              </ItemsPanelTemplate>
            </TreeView.ItemsPanel>
            <TreeView.DataTemplates>
              <TreeDataTemplate x:DataType="database:DatabaseMetadataObject" ItemsSource="{Binding Children}">
                <StackPanel Spacing="1" Margin="2,2">
                  <TextBlock Text="{Binding Name}" Classes="panel-title" />
                  <TextBlock Text="{Binding Kind}" Classes="secondary" />
                  <TextBlock Text="{Binding Details}" Classes="secondary" TextWrapping="NoWrap"
                             TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </TreeDataTemplate>
            </TreeView.DataTemplates>
          </TreeView>
        </Grid>
      </Grid>
      <GridSplitter Grid.Column="1" Width="3" HorizontalAlignment="Stretch"
                    ResizeDirection="Columns" />
      <Grid Grid.Column="2" x:Name="WorkspaceGrid" ColumnDefinitions="*,5,300" MinWidth="0">
        <Grid Grid.Column="0" RowDefinitions="*,3,190" MinWidth="0">
          <Grid Grid.Row="0">
            <TabControl x:Name="EditorTabs">
            <TabItem Header="SQL Editor" x:Name="SqlEditorTab">
              <Grid RowDefinitions="Auto,*">
                <Border Padding="7" BorderThickness="0,0,0,1"
                        BorderBrush="{DynamicResource StudioDividerBrush}">
                  <TextBlock Text="F5 executes the selected SQL. With no selection, F5 executes the entire editor content when it contains one statement; if it contains multiple statements, select the statement to execute. Separate statements with semicolons. Ctrl+Space opens Firebird SQL and database-object suggestions."
                             Classes="secondary" TextWrapping="Wrap" />
                </Border>
                <edit:TextEditor Grid.Row="1" x:Name="SqlEditor" ShowLineNumbers="True"
                                 WordWrap="False" HorizontalScrollBarVisibility="Auto"
                                 VerticalScrollBarVisibility="Auto"
                                 Text="-- Firebird Studio&#10;SELECT CURRENT_TIMESTAMP FROM RDB$DATABASE;" />
              </Grid>
            </TabItem>
            <TabItem x:Name="AddSqlEditorTab" IsTabStop="False" Width="40" MinWidth="40"
                     Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
              <TabItem.Header>
                <Grid Width="36" Height="30" HorizontalAlignment="Center" VerticalAlignment="Center">
                  <Button x:Name="AddSqlEditorButton" Content="+" Width="26" Height="26" Padding="0"
                          HorizontalAlignment="Center" VerticalAlignment="Center"
                          HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                          ToolTip.Tip="New SQL Editor" />
                </Grid>
              </TabItem.Header>
            </TabItem>
            <TabItem Header="Table: (select a table)" x:Name="TableDetailsTab" IsVisible="False">
              <Grid RowDefinitions="Auto,*">
                <Border Padding="8" BorderThickness="0,0,0,1"
                        BorderBrush="{DynamicResource StudioDividerBrush}">
                  <TextBlock x:Name="TableDetailsTitle" Text="Table details" Classes="section-title" />
                </Border>
                <TabControl Grid.Row="1">
                  <TabItem Header="Fields">
                    <TableView x:CompileBindings="False" x:Name="TableFieldsGrid" CanUserResizeColumns="True">
                      <TableView.Columns>
                        <TableViewColumn Header="Field" Binding="{Binding Name}" Width="2*" />
                        <TableViewColumn Header="Domain" Binding="{Binding Domain}" Width="2*" />
                        <TableViewColumn Header="Type" Binding="{Binding Type}" Width="2*" />
                        <TableViewColumn Header="Null" Binding="{Binding Nullable}" Width="Auto" />
                        <TableViewColumn Header="Position" Binding="{Binding Position}" Width="Auto" />
                      </TableView.Columns>
                    </TableView>
                  </TabItem>
                  <TabItem Header="Data">
                    <Grid RowDefinitions="Auto,*">
                      <Border Grid.Row="0" Padding="6" BorderThickness="0,0,0,1"
                              BorderBrush="{DynamicResource StudioDividerBrush}">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                          <Button Content="Previous" x:Name="PreviousTableDataPageButton" IsEnabled="False" />
                          <Button Content="Next" x:Name="NextTableDataPageButton" IsEnabled="False" />
                          <TextBlock x:Name="TableDataPageStatus" Text="No rows loaded" VerticalAlignment="Center" />
                        </StackPanel>
                      </Border>
                      <TableView Grid.Row="1" x:CompileBindings="False" x:Name="TableDataGrid" CanUserResizeColumns="True" />
                    </Grid>
                  </TabItem>
                  <TabItem Header="Constraints">
                    <ListBox x:Name="TableConstraintsList">
                      <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="database:DatabaseMetadataObject">
                          <StackPanel Margin="5,4" Spacing="2">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Details}" Classes="secondary" TextWrapping="Wrap" />
                          </StackPanel>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                  </TabItem>
                  <TabItem Header="DDL">
                    <edit:TextEditor x:Name="TableDdlText" IsReadOnly="True" ShowLineNumbers="True"
                                     WordWrap="False" HorizontalScrollBarVisibility="Auto"
                                     VerticalScrollBarVisibility="Auto" />
                  </TabItem>
                </TabControl>
              </Grid>
            </TabItem>
            <TabItem IsVisible="False" x:Name="QueryHistoryTab">
              <TabItem.Header>
                <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                  <TextBlock Text="Query History" VerticalAlignment="Center" />
                  <Button x:Name="ClearHistoryTabButton" Content="Clear" Padding="5,2"
                          ToolTip.Tip="Clear query history" />
                </StackPanel>
              </TabItem.Header>
              <ListBox x:Name="QueryHistoryTabList" SelectionMode="Single">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="services:QueryHistoryEntry">
                    <StackPanel Spacing="2" Margin="4,5">
                      <TextBlock Text="{Binding Summary}" Classes="panel-title" />
                      <TextBlock Text="{Binding Preview}" Classes="secondary" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </TabItem>
            </TabControl>
          </Grid>
          <GridSplitter Grid.Row="1" Height="3" HorizontalAlignment="Stretch"
                        ResizeDirection="Rows" Margin="3,0,0,0" />
          <TabControl Grid.Row="2" x:Name="ResultsMessagesTabs">
            <TabItem x:Name="ResultsTab">
              <TabItem.Header>
                <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                  <TextBlock Text="Results" VerticalAlignment="Center" />
                  <Button x:Name="ClearResultsButton" Content="Clear" Padding="5,2"
                          ToolTip.Tip="Clear the current query results" />
                </StackPanel>
              </TabItem.Header>
              <TableView x:CompileBindings="False" x:Name="QueryResultsGrid" CanUserResizeColumns="True" />
            </TabItem>
            <TabItem x:Name="MessagesTab">
              <TabItem.Header>
                <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                  <TextBlock Text="Messages" VerticalAlignment="Center" />
                  <Button x:Name="ClearMessagesButton" Content="Clear" Padding="5,2"
                          ToolTip.Tip="Clear the message log" />
                </StackPanel>
              </TabItem.Header>
              <ScrollViewer x:Name="MessagesScrollViewer" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="9" Spacing="8">
                  <TextBlock x:Name="StatusText" Text="Loading saved connection profiles..."
                             TextWrapping="Wrap" />
                  <Border Height="1" Background="{DynamicResource StudioDividerBrush}" />
                  <ItemsControl x:Name="MessageLogItems">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="services:StudioMessageEntry">
                        <Border Background="{Binding Background}" CornerRadius="4" Padding="9"
                                BorderThickness="1" BorderBrush="{Binding Foreground}" Opacity="0.96">
                          <StackPanel Spacing="4">
                            <TextBlock Text="{Binding TimestampText}" FontSize="{StaticResource StudioSecondaryFontSize}"
                                       Foreground="{Binding Foreground}" />
                            <TextBlock Text="{Binding Header}" FontWeight="SemiBold"
                                       Foreground="{Binding Foreground}" />
                            <TextBlock Text="{Binding Details}" TextWrapping="Wrap"
                                       FontFamily="{StaticResource StudioMonospaceFont}"
                                       Foreground="{Binding Foreground}" />
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </ScrollViewer>
            </TabItem>
          </TabControl>
        </Grid>
        <GridSplitter Grid.Column="1" ResizeDirection="Columns" x:Name="HistorySplitter" />
        <Border Grid.Column="2" x:Name="QueryHistoryPanel" Padding="8" Background="{DynamicResource StudioSurfaceBrush}" MinWidth="220"
                BorderThickness="1,0,0,0" BorderBrush="{DynamicResource StudioDividerBrush}">
          <Grid RowDefinitions="Auto,*">
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="2,2,2,8">
              <TextBlock Grid.Column="0" Text="Query history" Classes="panel-title"
                         VerticalAlignment="Center" />
              <Button Grid.Column="1" x:Name="ClearHistoryDockButton" Content="Clear"
                      Padding="5,2"
                      ToolTip.Tip="Clear query history" />
            </Grid>
            <ListBox Grid.Row="1" x:Name="QueryHistoryList" SelectionMode="Single">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="services:QueryHistoryEntry">
                  <StackPanel Spacing="3" Margin="3,5">
                    <TextBlock Text="{Binding Summary}" Classes="panel-title" />
                    <TextBlock Text="{Binding Preview}" Classes="secondary"
                               TextWrapping="Wrap" MaxLines="4" />
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Grid>
        </Border>
      </Grid>
    </Grid>

    <Border Grid.Row="2" Padding="8,4" BorderThickness="0,1,0,0"
            BorderBrush="{DynamicResource StudioDividerBrush}">
      <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto" ColumnSpacing="18">
        <TextBlock Grid.Column="0" x:Name="ConnectionStateText" Text="Not connected"
                   Classes="secondary error" FontWeight="SemiBold" />
        <TextBlock Grid.Column="1" Text="Firebird provider 10.3.4" Classes="secondary"
                   VerticalAlignment="Center" />
        <TextBlock Grid.Column="2" x:Name="CurrentVersionText" Text="Firebird Studio 0.1.0" Classes="secondary"
                   VerticalAlignment="Center" />
        <TextBlock Grid.Column="3" x:Name="FooterNotificationText" FontSize="{StaticResource StudioSecondaryFontSize}"
                   VerticalAlignment="Center" HorizontalAlignment="Center"
                   TextAlignment="Center" FontWeight="SemiBold" IsVisible="False" />
        <TextBlock Grid.Column="4" Text=".NET 10 · Avalonia 12" Classes="secondary"
                   VerticalAlignment="Center" />
      </Grid>
    </Border>
  </Grid>
</Window>
