<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:FirebirdStudio.Desktop.Services"
    x:Class="FirebirdStudio.Desktop.Views.ConnectionPasswordWindow"
    Width="420"
    SizeToContent="Height"
    MinWidth="360"
    WindowStartupLocation="CenterOwner"
    CanResize="False"
    Title="{loc:StudioText ConnectWindowTitle}">
  <StackPanel Margin="18" Spacing="12">
    <TextBlock x:Name="ConnectionNameText" Classes="section-title" />
    <TextBlock x:Name="CredentialStoreStatusText" Text="{loc:StudioText EnterPassword}" TextWrapping="Wrap" />
    <TextBox x:Name="PasswordInput" PasswordChar="●" IsUndoEnabled="False" />
    <CheckBox x:Name="RememberPasswordCheckBox" Content="{loc:StudioText RememberPassword}" IsChecked="False" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button x:Name="CancelButton" Classes="action" Content="{loc:StudioText Cancel}" />
      <Button x:Name="ConnectButton" Classes="action accent" AutomationProperties.Name="{loc:StudioText Connect}" IsDefault="True">
        <StackPanel Classes="action-label">
          <PathIcon Classes="action-icon" Data="{StaticResource ActionConnectIcon}" />
          <TextBlock Text="{loc:StudioText Connect}" />
        </StackPanel>
      </Button>
    </StackPanel>
  </StackPanel>
</Window>
