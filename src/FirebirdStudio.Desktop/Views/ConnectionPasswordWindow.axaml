<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="FirebirdStudio.Desktop.Views.ConnectionPasswordWindow"
    Width="420"
    SizeToContent="Height"
    MinWidth="360"
    WindowStartupLocation="CenterOwner"
    CanResize="False"
    Title="Connect to Firebird">
  <StackPanel Margin="18" Spacing="12">
    <TextBlock x:Name="ConnectionNameText" Classes="section-title" />
    <TextBlock x:Name="CredentialStoreStatusText" Text="Enter the database password." TextWrapping="Wrap" />
    <TextBox x:Name="PasswordInput" PasswordChar="●" IsUndoEnabled="False" />
    <CheckBox x:Name="RememberPasswordCheckBox" Content="Remember this password in the operating system credential store" IsChecked="False" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button x:Name="CancelButton" Classes="action" Content="Cancel" />
      <Button x:Name="ConnectButton" Classes="action accent" AutomationProperties.Name="Connect" IsDefault="True">
        <StackPanel Classes="action-label">
          <PathIcon Classes="action-icon" Data="{StaticResource ActionConnectIcon}" />
          <TextBlock Text="Connect" />
        </StackPanel>
      </Button>
    </StackPanel>
  </StackPanel>
</Window>
