<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:FirebirdStudio.Desktop.Services"
             xmlns:services="using:FirebirdStudio.Desktop.Services"
             x:Class="FirebirdStudio.Desktop.Views.QueryHistoryView">
  <UserControl.Styles>
    <Style Selector="ListBox#HistoryEntries ListBoxItem">
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="8,5" />
      <Setter Property="AutomationProperties.Name" Value="{ReflectionBinding Preview}" />
      <Setter Property="AutomationProperties.HelpText" Value="{ReflectionBinding AccessibleDetails}" />
    </Style>
    <Style Selector="ListBox#HistoryEntries ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource StudioListSelectionBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource StudioFocusBrush}" />
      <Setter Property="BorderThickness" Value="1,0,0,0" />
    </Style>
  </UserControl.Styles>
  <Grid RowDefinitions="Auto,*,Auto" RowSpacing="6">
    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="4">
      <TextBlock x:Name="HistoryTitle" Text="{loc:StudioText QueryHistory}" Classes="panel-title" IsVisible="False"
                 VerticalAlignment="Center" />
      <Button Grid.Column="1" x:Name="ClearHistoryButton" Classes="action compact"
              IsEnabled="{Binding !!#HistoryEntries.ItemCount}"
              AutomationProperties.Name="{loc:StudioText ClearHistory}" ToolTip.Tip="{loc:StudioText ClearHistory}">
        <StackPanel Classes="action-label">
          <PathIcon Classes="action-icon" Data="{StaticResource ActionClearIcon}" />
          <TextBlock Text="{loc:StudioText Clear}" />
        </StackPanel>
      </Button>
      <Button Grid.Column="2" x:Name="CollapseHistoryButton" Classes="action icon-only" IsVisible="False"
              AutomationProperties.Name="{loc:StudioText CollapseHistory}" ToolTip.Tip="{loc:StudioText CollapseHistory}">
        <PathIcon Classes="action-icon" Data="{StaticResource ActionCollapseRightIcon}" />
      </Button>
    </Grid>
    <Grid Grid.Row="1">
      <ListBox x:Name="HistoryEntries" SelectionMode="Single" Background="Transparent"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="{loc:StudioText HistoryEntries}">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="services:QueryHistoryEntry">
            <Grid RowDefinitions="Auto,Auto" RowSpacing="2">
              <TextBlock Text="{Binding Preview}" FontFamily="{StaticResource StudioMonospaceFont}"
                         TextTrimming="CharacterEllipsis" />
              <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBlock Text="{Binding ExecutionContext}" Classes="secondary" TextTrimming="CharacterEllipsis"
                           ToolTip.Tip="{Binding ExecutionContext}" />
                <TextBlock Grid.Column="1" Text="{Binding Status}" Classes="secondary"
                           Classes.success="{Binding Succeeded}" Classes.error="{Binding HasFailed}"
                           Classes.information="{Binding IsCancelled}" ToolTip.Tip="{Binding Outcome}" />
              </Grid>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <TextBlock Text="{loc:StudioText NoHistory}" Classes="secondary" IsVisible="{Binding !#HistoryEntries.ItemCount}"
                 IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Grid>
    <Border Grid.Row="2" x:Name="HistoryPreview" IsVisible="False" Height="160" Padding="0,6,0,0"
            BorderBrush="{DynamicResource StudioDividerBrush}" BorderThickness="0,1,0,0">
      <Grid RowDefinitions="Auto,*" RowSpacing="6">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
          <TextBlock Text="{loc:StudioText SqlPreview}" Classes="panel-title" VerticalAlignment="Center" />
          <Button Grid.Column="1" x:Name="RestoreHistoryButton" Classes="action compact"
                  AutomationProperties.Name="{loc:StudioText RestoreSql}" ToolTip.Tip="{loc:StudioText RestoreSqlShortcut}">
            <StackPanel Classes="action-label">
              <PathIcon Classes="action-icon" Data="{StaticResource ActionRestoreIcon}" />
              <TextBlock Text="{loc:StudioText Restore}" />
            </StackPanel>
          </Button>
        </Grid>
        <TextBox Grid.Row="1" x:Name="HistoryPreviewSql" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                 ScrollViewer.VerticalScrollBarVisibility="Auto" FontFamily="{StaticResource StudioMonospaceFont}"
                 SelectionBrush="{DynamicResource SqlSelectionBackground}"
                 SelectionForegroundBrush="{DynamicResource SqlSelectionForeground}"
                 AutomationProperties.Name="{loc:StudioText SelectedSqlPreview}" />
      </Grid>
    </Border>
  </Grid>
</UserControl>
